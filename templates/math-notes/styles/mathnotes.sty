\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/mathnotes}[2026/08/28 A simple style for mathematical notes]

\RequirePackage{iftex}
\ifXeTeX\else
  \PackageError{mathnotes}{This template requires XeLaTeX}{Run latexmk or xelatex main.tex.}
\fi

\PassOptionsToPackage{warnings-off={mathtools-colon,mathtools-overbracket}}{unicode-math}
\RequirePackage{mathtools}
\RequirePackage{newcomputermodern}
\RequirePackage{polyglossia}
\setmainlanguage{english}

\RequirePackage[a4paper,margin=27mm,headheight=15pt]{geometry}
\RequirePackage{microtype}
\RequirePackage{setspace}
\setstretch{1.08}
\setlength{\parindent}{1.25em}
\setlength{\parskip}{0.2em}
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000

\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{enumitem}
\RequirePackage{amsthm}
\RequirePackage{aliascnt}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{hyperref}
\RequirePackage{bookmark}
\RequirePackage[capitalise,noabbrev]{cleveref}

\graphicspath{{images/}}
\setlist{nosep,leftmargin=2em}

\definecolor{NotesInk}{HTML}{20242A}
\definecolor{NotesMuted}{HTML}{68707A}
\definecolor{NotesAccent}{HTML}{285EA8}
\definecolor{NotesAccentLight}{HTML}{F2F6FC}
\definecolor{NotesWarm}{HTML}{9A5700}
\definecolor{NotesWarmLight}{HTML}{FFF8EC}
\definecolor{NotesLine}{HTML}{D9DEE5}

\hypersetup{
  colorlinks=true,
  linkcolor=NotesAccent,
  urlcolor=NotesAccent,
  citecolor=NotesAccent
}
\AtBeginDocument{%
  \hypersetup{pdfauthor={\noteauthor},pdftitle={\notetitle}}%
}

\titleformat{\chapter}[display]
  {\normalfont}
  {\color{NotesMuted}\large\bfseries CHAPTER~\thechapter}
  {0.45em}
  {\color{NotesInk}\Huge\bfseries}
\titleformat{name=\chapter,numberless}[display]
  {\normalfont\color{NotesInk}\Huge\bfseries}
  {}
  {0pt}
  {}
\titlespacing*{\chapter}{0pt}{-15pt}{28pt}

\titleformat{\section}
  {\normalfont\Large\bfseries\color{NotesInk}}
  {\thesection}{0.75em}{}
\titleformat{\subsection}
  {\normalfont\large\bfseries\color{NotesInk}}
  {\thesubsection}{0.75em}{}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\color{NotesMuted}\nouppercase{\leftmark}}
\fancyhead[R]{\small\color{NotesMuted}\thepage}
\renewcommand{\headrulewidth}{0pt}
\fancypagestyle{plain}{
  \fancyhf{}
  \fancyfoot[C]{\small\color{NotesMuted}\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

\newcommand{\makemathtitle}{%
  \begin{titlepage}
    \centering
    \vspace*{0.27\textheight}
    {\fontsize{30}{36}\selectfont\bfseries\color{NotesInk}\notetitle\par}
    \vspace{0.8em}
    {\Large\color{NotesMuted}\notesubtitle\par}
    \vfill
    {\large\noteauthor\par}
    \vspace{0.35em}
    {\color{NotesMuted}\noteinstitution\par}
    \vspace{1.5em}
    {\color{NotesMuted}\notedate\par}
  \end{titlepage}
}

\newtheoremstyle{notesplain}
  {10pt}{10pt}
  {\itshape}{0pt}
  {\bfseries\color{NotesAccent}}
  {.}{0.6em}{}

\newtheoremstyle{notesdefinition}
  {10pt}{10pt}
  {\normalfont}{0pt}
  {\bfseries\color{NotesAccent}}
  {.}{0.6em}{}

\newtheoremstyle{notesremark}
  {8pt}{8pt}
  {\normalfont}{0pt}
  {\bfseries\color{NotesMuted}}
  {.}{0.6em}{}

\theoremstyle{notesplain}
\newtheorem{theorem}{Theorem}[chapter]
\newaliascnt{lemma}{theorem}
\newtheorem{lemma}[lemma]{Lemma}
\aliascntresetthe{lemma}
\newaliascnt{proposition}{theorem}
\newtheorem{proposition}[proposition]{Proposition}
\aliascntresetthe{proposition}
\newaliascnt{corollary}{theorem}
\newtheorem{corollary}[corollary]{Corollary}
\aliascntresetthe{corollary}

\theoremstyle{notesdefinition}
\newaliascnt{definition}{theorem}
\newtheorem{definition}[definition]{Definition}
\aliascntresetthe{definition}
\newaliascnt{example}{theorem}
\newtheorem{example}[example]{Example}
\aliascntresetthe{example}

\theoremstyle{notesremark}
\newaliascnt{remark}{theorem}
\newtheorem{remark}[remark]{Remark}
\aliascntresetthe{remark}

\newtheoremstyle{notesproblem}
  {10pt}{10pt}
  {\normalfont}{0pt}
  {\bfseries\color{NotesWarm}}
  {.}{0.6em}{}
\theoremstyle{notesproblem}
\newtheorem{problem}{Problem}[chapter]

\tcolorboxenvironment{definition}{
  enhanced jigsaw,
  breakable,
  colback=NotesAccentLight,
  frame hidden,
  borderline west={2pt}{0pt}{NotesAccent},
  sharp corners,
  boxsep=0pt,
  left=10pt,right=10pt,top=8pt,bottom=8pt,
  before skip=10pt,after skip=10pt
}

\tcolorboxenvironment{problem}{
  enhanced jigsaw,
  breakable,
  colback=NotesWarmLight,
  frame hidden,
  borderline west={2pt}{0pt}{NotesWarm},
  sharp corners,
  boxsep=0pt,
  left=10pt,right=10pt,top=8pt,bottom=8pt,
  before skip=10pt,after skip=10pt
}

\newenvironment{solution}[1][Solution]
  {\begin{proof}[#1]}
  {\end{proof}}

\newtcolorbox{notation}[1][Notation]{
  enhanced,
  breakable,
  colback=white,
  colframe=NotesLine,
  coltitle=NotesInk,
  fonttitle=\bfseries,
  title={#1},
  arc=1mm,
  boxrule=0.6pt,
  left=9pt,right=9pt,top=7pt,bottom=7pt,
  before skip=9pt,after skip=9pt
}

\newtcolorbox{summary}[1][Key idea]{
  enhanced,
  breakable,
  colback=NotesAccentLight,
  colframe=NotesAccentLight,
  coltitle=NotesAccent,
  fonttitle=\bfseries,
  title={#1},
  arc=1mm,
  boxrule=0pt,
  left=9pt,right=9pt,top=7pt,bottom=7pt,
  before skip=9pt,after skip=9pt
}

\newcommand{\term}[1]{\textbf{#1}}
\newcommand{\N}{\mathbb{N}}
\newcommand{\Z}{\mathbb{Z}}
\newcommand{\Q}{\mathbb{Q}}
\newcommand{\R}{\mathbb{R}}
\newcommand{\C}{\mathbb{C}}

\crefname{problem}{problem}{problems}
\Crefname{problem}{Problem}{Problems}

\endinput
