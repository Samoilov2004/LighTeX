{
  "schemaVersion": 2,
  "id": "course-notes",
  "name": "Course Notes",
  "description": "A compact single-chapter notebook for lectures, mathematics, and code.",
  "category": "essentials",
  "sortOrder": 30,
  "engine": "xelatex",
  "entry": "main.tex",
  "preview": "preview-strict.png",
  "previewVariants": {
    "none": "preview-none.png",
    "strict": "preview-strict.png",
    "colorful": "preview-colorful.png",
    "none-perChapter": "preview-none-per-chapter.png",
    "strict-perChapter": "preview-strict-per-chapter.png",
    "colorful-perChapter": "preview-colorful-per-chapter.png"
  },
  "documentClass": "report",
  "tags": ["notes", "mathematics", "theorems", "code"],
  "codeStyles": ["none", "strict", "colorful"],
  "codeLanguages": ["python", "sql", "cpp", "javaScript", "rust", "java", "shell"],
  "defaultCodeStyle": "strict",
  "defaultCodeLanguages": ["python", "sql"],
  "sectionNumberings": ["hierarchical", "perChapter"],
  "defaultSectionNumbering": "perChapter"
}
